  "base_css": ".artboard{width:1080px;height:1080px;background:var(--bg);font-family:var(--font-family);color:var(--text);display:flex;align-items:stretch;justify-content:center;box-sizing:border-box;padding:64px}.slide{width:100%;height:100%;box-sizing:border-box;display:grid;grid-template-rows:auto 1fr auto;gap:24px;position:relative;--headline-max-w:820px;--headline-y:0px;--subhead-max-w:680px;--subhead-y:0px;--headline-align:left;--accent-style:ellipse;--cta-text:''}.theme--light{--bg:var(--bg-light);--text:var(--text-dark)}.theme--orange{--bg:var(--bg-orange);--text:var(--text-dark)}.theme--dark{--bg:var(--bg-dark);--text:var(--text-light)}.headline{font-size:clamp(48px,6vw,92px);line-height:0.96;font-weight:var(--headline-weight);letter-spacing:-0.02em;max-width:var(--headline-max-w);text-align:var(--headline-align);margin-top:var(--headline-y)}.subhead{font-size:clamp(18px,2vw,24px);line-height:1.25;color:var(--muted);max-width:var(--subhead-max-w);margin-top:var(--subhead-y)}.pill{display:inline-flex;align-items:center;gap:10px;padding:12px 22px;border-radius:var(--pill);font-weight:700;font-size:16px;border:2px solid currentColor}.pill--filled{background:var(--text);color:var(--bg)}.pill--outline{background:transparent}.accent{position:relative;display:inline-block;padding:0 8px}.accent--ellipse:after{content:'';position:absolute;left:-6px;right:-6px;top:55%;height:1.1em;border:3px solid var(--accent);border-radius:999px;transform:translateY(-50%) rotate(-5deg)}.accent--underline:after{content:'';position:absolute;left:0;right:0;bottom:-6px;height:6px;background:var(--accent);border-radius:999px}.corner-glyph{position:absolute;font-size:20px;font-weight:700;opacity:0.9}.corner-glyph--tl{top:24px;left:24px}.corner-glyph--tr{top:24px;right:24px}.footer{display:flex;align-items:center;justify-content:space-between;font-size:16px;font-weight:700}.footer .logo{display:flex;align-items:center;gap:10px}.footer .page{font-size:20px}.nextpage{position:absolute;right:48px;bottom:48px;display:flex;align-items:center;gap:10px;font-size:14px;letter-spacing:0.02em}.nextpage .arrow{width:48px;height:28px;border-radius:999px;border:2px solid var(--accent);display:flex;align-items:center;justify-content:center}.card{background:var(--bg-light);border-radius:var(--card);padding:40px;box-shadow:0 10px 30px rgba(0,0,0,0.08)}.badge-row{display:flex;flex-wrap:wrap;gap:12px}.number-giant{font-size:clamp(120px,18vw,320px);font-weight:800;letter-spacing:-0.02em;line-height:0.9}.muted{color:var(--muted)}.photo-circle{width:360px;height:360px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;overflow:hidden}.photo-card{display:grid;grid-template-columns:1.1fr 0.9fr;gap:24px;align-items:center}.diagonal-shape{position:absolute;right:80px;top:80px;width:420px;height:420px;border-radius:50%;background:var(--accent)}.line-frame{border:2px solid currentColor;border-radius:20px;padding:32px}" ,
